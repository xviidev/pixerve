PORT=3000

# Local development: uncomment SOURCE_DIR to avoid using S3.
# SOURCE_DIR=static
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY_SECRET=
S3_BUCKET=
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto

# Small-server defaults. Zero disables either result cache.
MEM_CACHE_MB=8
DISK_CACHE_MB=256
DISK_CACHE_DIR=.cache/images
CACHE_TTL=86400
CACHE_IDLE_SECS=300
VIPS_CONCURRENCY=1
MAX_CONCURRENT=1
MAX_QUEUE=16
MAX_REQUESTS=128
MAX_SOURCE_MB=20
MAX_INPUT_PIXELS=40000000
MP_LIMIT=12

# Relative to the repository root; Docker overrides both.
STATIC_DIR=static
OG_WATERMARK=assets/og_wm.png

SIGNING_KEY=
OPEN_MAX_W=1280
OPEN_MAX_H=1200
OPEN_MAX_MP=3
OPEN_MAX_BLUR=10
OPEN_ALLOWED_FORMATS=avif,webp,jpeg
# Compatibility: 5 requests per 60-second window, not 5 per second.
OPEN_RPS=5
OPEN_WINDOW=60
# Enable only behind a trusted reverse proxy that replaces client IP headers.
TRUST_PROXY=false
RUST_LOG=pixerve=info

# CDN policies. Bump PIPELINE_VERSION when changing encoder behavior/watermark.
PIPELINE_VERSION=1
CACHE_VISIBILITY=public
BROWSER_CACHE_TTL=300
CDN_CACHE_TTL=86400
IMMUTABLE_CACHE_TTL=31536000
STALE_WHILE_REVALIDATE=60
STALE_IF_ERROR=86400
CANONICAL_REDIRECTS=true
# Enable after migrating CMS URLs to thumbnail/card/article/wide/og presets.
PRESETS_ONLY=false
# Empty disables /metrics. Otherwise at least 16 characters; send as Bearer token.
METRICS_TOKEN=
# Optional: CDN injects this secret in X-Img-Origin-Token on origin requests.
# Keep it out of browser requests, HTML and URLs. Empty allows direct access.
ORIGIN_TOKEN=
